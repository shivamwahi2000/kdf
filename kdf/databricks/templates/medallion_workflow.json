{
  "name": "KDF Medallion Workflow - Bronze → Silver → Gold",
  "tasks": [
    {
      "task_key": "bronze_layer",
      "description": "Bronze layer - Raw data ingestion",
      "notebook_task": {
        "notebook_path": "/Workspace/kdf/notebooks/run_kdf_pipeline",
        "base_parameters": {
          "config_path": "dbfs:/kdf/configs/medallion_workflow.yaml",
          "metadata_path": "/kdf/metadata",
          "config_type": "medallion",
          "pipeline_name": "bronze_orders"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "kdf_cluster",
      "timeout_seconds": 3600,
      "max_retries": 2
    },
    {
      "task_key": "silver_layer",
      "description": "Silver layer - Clean and validate",
      "depends_on": [
        {
          "task_key": "bronze_layer"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/kdf/notebooks/run_kdf_pipeline",
        "base_parameters": {
          "config_path": "dbfs:/kdf/configs/medallion_workflow.yaml",
          "metadata_path": "/kdf/metadata",
          "config_type": "medallion",
          "pipeline_name": "silver_orders"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "kdf_cluster",
      "timeout_seconds": 3600,
      "max_retries": 2
    },
    {
      "task_key": "gold_layer",
      "description": "Gold layer - Business metrics",
      "depends_on": [
        {
          "task_key": "silver_layer"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/kdf/notebooks/run_kdf_pipeline",
        "base_parameters": {
          "config_path": "dbfs:/kdf/configs/medallion_workflow.yaml",
          "metadata_path": "/kdf/metadata",
          "config_type": "medallion",
          "pipeline_name": "gold_daily_revenue"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "kdf_cluster",
      "timeout_seconds": 3600,
      "max_retries": 2
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "kdf_cluster",
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 4,
        "spark_conf": {
          "spark.databricks.delta.preview.enabled": "true",
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true",
          "spark.sql.adaptive.enabled": "true"
        },
        "custom_tags": {
          "framework": "kdf",
          "version": "0.1",
          "architecture": "medallion"
        }
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "America/Los_Angeles",
    "pause_status": "UNPAUSED"
  },
  "format": "MULTI_TASK",
  "max_concurrent_runs": 1,
  "timeout_seconds": 10800,
  "email_notifications": {
    "on_failure": ["data-engineering@company.com"],
    "on_success": [],
    "no_alert_for_skipped_runs": false
  }
}
